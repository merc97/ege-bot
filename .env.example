# ===== Telegram =====
BOT_TOKEN=your_bot_token_here
ADMIN_IDS=123456789,987654321

# ===== Database =====
POSTGRES_DB=ege_bot
POSTGRES_USER=ege
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD
DATABASE_URL=postgresql://ege:CHANGE_ME_STRONG_PASSWORD@postgres:5432/ege_bot

# ===== Redis =====
REDIS_URL=redis://redis:6379/0

# ===== Internal API (bot <-> backend) =====
API_KEY=CHANGE_ME_INTERNAL_SECRET_KEY
BACKEND_URL=http://backend:8000

# ===== AI (OpenRouter) =====
OPENROUTER_API_KEY=sk-or-v1-...
AI_MODEL=qwen/qwen2.5-3b-instruct
AI_MAX_TOKENS=150
AI_TEMPERATURE=0.3

# ===== Payments: Telegram Stars =====
# Stars работают нативно через aiogram, доп. ключи не нужны

# ===== Payments: YooKassa =====
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_RETURN_URL=https://t.me/your_bot_username

# ===== App =====
DEBUG=false
LOG_LEVEL=INFO
QUESTIONS_DIR=/app/questions
